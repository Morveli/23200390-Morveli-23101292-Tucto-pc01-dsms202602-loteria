rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección "jugadas"
    match /jugadas/{userId} {
      // Solo el usuario autenticado propietario puede leer su propia jugada
      allow read: if request.auth != null && request.auth.uid == userId;

      // Permitir crear la jugada si el usuario está autenticado, es su propio documento,
      // la lista contiene exactamente 6 números enteros únicos entre 1 y 45,
      // y el sorteo actual se encuentra en estado "ABIERTO".
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.numeros is list
                    && request.resource.data.numeros.size() == 6
                    && request.resource.data.numeros.toSet().size() == 6
                    && get(/databases/$(database)/documents/sorteos/actual).data.estado == 'ABIERTO';

      // Impedir modificaciones o eliminaciones de jugadas una vez confirmadas
      allow update, delete: if false;
    }

    // Reglas para la colección "sorteos"
    match /sorteos/{sorteoId} {
      // Los participantes autenticados pueden leer el estado del sorteo y las bolillas en tiempo real
      allow read: if request.auth != null;

      // Únicamente la consola de Firebase / Administradores pueden modificar el sorteo
      allow write: if false;
    }
  }
}
